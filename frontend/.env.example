# Upstream backend URL for Vite dev/preview proxy (/api -> backend)
#
# Option A: Local backend (default when running backend locally on port 7000)
BACKEND_INTERNAL_URL=http://localhost:7000

# Option B: Live Render backend (uncomment to connect your local frontend to the cloud API)
# BACKEND_INTERNAL_URL=https://optico-wsi9.onrender.com
