# OptiCo API environment. Copy to .env and replace every placeholder.
APP_NAME=OptiCo API
NODE_ENV=development
PORT=7000

# Public site URLs. FRONTEND_ORIGINS is a comma-separated exact allowlist.
FRONTEND_URL=http://localhost:3001
FRONTEND_ORIGINS=http://localhost:3001
BACKEND_URL=http://localhost:7000
APP_PUBLIC_URL=http://localhost:3001

# Neon: runtime pool URL, and an optional direct URL for migrations.
DATABASE_URL=postgresql://user:password@localhost:5432/optico?sslmode=require
MIGRATION_DATABASE_URL=

# Both secrets must be at least 32 characters and must differ.
JWT_SECRET=replace-with-a-32-plus-character-random-secret
CSRF_SECRET=replace-with-a-different-32-plus-character-secret

# Optional SMTP. When SMTP_HOST is empty, email is logged and skipped.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM_NAME=OptiCo
SMTP_FROM_EMAIL=

GUEST_LINK_TTL_HOURS=168
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=7
